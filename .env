# SQL Server (hostnames and usernames)
DB_SERVER_TEST=your_test_sql_host
DB_SERVER_PROD=your_prod_sql_host
DB_PORT=1433

DB_USER_TEST=your_tracking_user
DB_USER_PROD=your_webplus_user
DB_USER_PREP=your_prepplus_user
DB_USER_CRS=your_crsplus_user

# Keyring service names
KEYRING_SERVICE_TEST=your_keyring_service_for_tracking
KEYRING_SERVICE_PROD=your_keyring_service_for_webplus
KEYRING_SERVICE_PREP=your_keyring_service_for_prepplus
KEYRING_SERVICE_CRS=your_keyring_service_for_crsplus

# Email / SMTP
EMAIL_ENABLED=true
SMTP_HOST=your_host_internal
SMTP_PORT=25
EMAIL_FROM=your_email_address
EMAIL_CC = ["person1@some_domain.com", "person2@some_domain.com", "person3@some_domain.com"]
EMAIL_FALLBACK_TO = "fallback_person@some_domain.com"

# Directories
HIGH_VOLUME_OUT_DIR=Destination Location of your high volume files in your PC
LOWMID_SRC_DIR=Destination Location of your low/mid volume files in your PC
LOWMID_DEST_DIR=Destination Location of your low/mid volume files in your PC
